# Futu OpenD connection configuration
# Copy this to .env and fill in your actual values.
# .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# OpenD Gateway Hosts
# ---------------------------------------------------------------------------
# Comma-separated list of host:port:is_rsa entries for HA gateway selection.
# is_rsa=True  for a gateway configured with protocol encryption
# is_rsa=False for a gateway with no protocol encryption
#
# When is_rsa is omitted it defaults to True, which is what you want for almost
# every gateway. FutuOpenD enables protocol encryption whenever it is started
# with a protocol-encryption key, and that includes gateways on localhost --
# "localhost implies no RSA" is false.
#
# Example (localhost with RSA):
#   FUTU_OPEND_HOSTS="127.0.0.1:11111:True"
# Example (localhost with no RSA -- uncommon):
#   FUTU_OPEND_HOSTS="127.0.0.1:11111:False"
# Example (HA, two remote gateways with RSA):
#   FUTU_OPEND_HOSTS="10.0.0.1:11111:True,10.0.0.2:11111:True"

# For a single host, not using HA. Only consulted when FUTU_OPEND_HOSTS is
# unset, and it cannot express per-host HA. It applies the same default as
# above, so if your gateway uses protocol encryption it needs FUTU_RSA_KEY set.
FUTU_ADDR=127.0.0.1:11111

# ---------------------------------------------------------------------------
# RSA Configuration
# ---------------------------------------------------------------------------
# Path to the RSA private key. Required whenever the gateway is configured with
# protocol encryption -- including a gateway on localhost. The path must match
# <rsa_private_key> in the gateway's FutuOpenD.xml, typically something like:
#
#   /opt/futu/opend/keys/futu_api_private_key.pem
#
# If this path is wrong or unreadable, examples do not fail fast: the SDK retries
# the handshake indefinitely, so the example appears to hang and then reports a
# timeout with "check sha error". connect.py now validates this path before
# attempting a handshake and raises an error naming the path instead.
FUTU_RSA_KEY=/opt/futu/opend/keys/futu_api_private_key.pem

# ---------------------------------------------------------------------------
# Connection Timeouts
# ---------------------------------------------------------------------------
# TCP probe timeout in seconds
FUTU_TCP_TIMEOUT=3

# ---------------------------------------------------------------------------
# Trade (Demo / SIMULATE only)
# ---------------------------------------------------------------------------
# Demo SIMULATE trade unlock password — NEVER use real account passwords here
# This project is for DEMO purposes only.
FUTU_TRADE_PWD=123456